# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Database (Supabase Postgres)
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used for running migrations.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth (Supabase Auth)
# URL and anon/publishable key are safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret — server-only, bypasses RLS. Required: the booking/checkout flow,
# admin pages, and webhook/cron handlers all write through this client
# (see lib/supabase/admin.ts), since RLS intentionally has no write
# policies for authenticated users on trips/tiers/bookings/payments.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode)
# Secret — server-only, never sent to the browser.
STRIPE_SECRET_KEY=
# Publishable key IS meant for the browser (NEXT_PUBLIC_) — used by the
# Payment Element on the client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret for the webhook endpoint (app/api/webhooks/stripe). With
# the Stripe CLI: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# prints this value.
STRIPE_WEBHOOK_SECRET=

# Shared secret for both crons in vercel.json: the installment charger
# (app/api/cron/charge-installments) and the post-booking emails
# (app/api/cron/post-booking-emails).
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on cron-triggered
# requests when this is set as a project env var — generate any random string,
# e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Email (Resend) — booking confirmation, installment receipt, and
# payment-failed/action-required emails (see lib/email/send.ts), and the
# designed confirmation and 72-hour chase (lib/email/post-booking.ts).
# Secret — server-only.
RESEND_API_KEY=
# Required — Resend has no zero-setup sandbox sender; every send needs a
# domain verified in Resend's dashboard (Domains -> Add Domain, add the
# DNS records it gives you: SPF, DKIM and DMARC, all three). Once verified,
# production is "Outrider <bookings@outrider.travel>". Booking mail sets
# reply-to to this same address, so it must be a real inbox a person
# watches. Never a noreply@ address: the emails promise a person answers.
EMAIL_FROM_ADDRESS=

# The public origin, resolved by lib/site-url.ts. Falls back to Vercel's own
# deployment URL if unset, then to localhost for local dev.
# Set it in production: it builds every absolute link that leaves the app,
# including the Supabase confirmation and password-reset links (see the
# emailRedirectTo / redirectTo options in app/auth/actions.ts). Left empty,
# a confirmation email sent from a laptop points the recipient's phone at
# localhost. Whatever it is set to must also be listed under Authentication
# -> URL Configuration -> Redirect URLs in the Supabase dashboard.
# This is the variable the owner's brief calls NEXT_PUBLIC_SITE_URL. There is
# deliberately no second variable: lib/site-url.ts already resolves the
# origin from this one (with Vercel and localhost fallbacks), and two names
# for the same value would drift. Portal links in email are built from it.
NEXT_PUBLIC_APP_URL=

# Waitlist (Resend audiences) — the coming-soon landing page's email capture
# (see app/waitlist-actions.ts).
# Required for signups to work. Resend -> Audiences -> create one, then copy
# its id. Resend has renamed audiences to "segments" in newer docs; it's the
# same object and the same id.
RESEND_AUDIENCE_ID=
# Optional. Adding a contact needs audience access, which RESEND_API_KEY
# above deliberately doesn't have — it's scoped to sending so that a leak
# can't read your list. Set a second key with audience access here to keep
# that split, or leave this blank and widen RESEND_API_KEY instead.
RESEND_CONTACTS_API_KEY=
# Optional. An address to notify on each signup. Sends from
# EMAIL_FROM_ADDRESS, so it needs the same verified domain; leave blank to
# turn signup notifications off.
WAITLIST_NOTIFY_TO=

# Checkout sandbox (see lib/booking-window.ts). Set to 1 to open bookings on a
# local or Vercel Preview build so the Stripe checkout can be tested. Ignored on
# Vercel production and whenever the Stripe publishable key is not a pk_test_
# key. Test trips (names starting "[seed] " or "[test] ") are listed only here.
NEXT_PUBLIC_CHECKOUT_SANDBOX=

# Trip portal (/trip/[bookingId]?t=...), see lib/portal-token.ts.
# Secret, server-only. Signs the password-less links to a booking's trip page
# that go out in the confirmation email and the follow-up. Generate with
# `openssl rand -hex 32`; at least 32 characters. If unset, portal links are
# not created and every existing link stops working (fail closed). Rotating it
# invalidates every link already sent; travelers can ask the page for a fresh
# one, which goes to the booking's own email.
PORTAL_TOKEN_SECRET=

# The number travelers text or call about their trip. Both are required for
# the designed confirmation and chase emails (lib/email/post-booking.ts):
# without them the confirmation falls back to the plain one and the chase is
# skipped. SMS_NUMBER also appears in the Terms' text-message section, which
# is built at deploy time, so redeploy after setting it.
# Display form, shown on pages and in email, e.g. "(970) 555-0123".
SMS_NUMBER=
# The same number in E.164 dial form, for tel:/sms: links, e.g. "+19705550123".
SMS_NUMBER_RAW=
