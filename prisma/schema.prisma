// Prisma schema for Outrider — connection settings live in prisma.config.ts (Prisma v7).
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// id is not app-generated: it's set to the matching auth.users.id by the
// handle_new_user trigger (see the link_users_to_auth_and_sync_trigger
// migration), and Prisma never inserts User rows directly.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  phone     String?
  role      UserRole @default(customer)
  createdAt DateTime @default(now()) @map("created_at")

  // Populated on first deposit checkout (see lib/customers.ts). authenticated
  // only has column-level UPDATE on name/phone (see the
  // add_installment_payment_plan migration) — these two are service-role-only
  // writes, since a user rewriting them could redirect future installment
  // charges onto a different Stripe Customer's saved card.
  stripeCustomerId             String? @unique @map("stripe_customer_id")
  stripeDefaultPaymentMethodId String? @map("stripe_default_payment_method_id")

  bookings         Booking[]
  legalAcceptances LegalAcceptance[]

  @@map("users")
}

enum UserRole {
  customer
  admin

  @@map("user_role")
}

model Trip {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  destination String
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime   @map("end_date") @db.Date
  description String?
  logistics   String?
  status      TripStatus @default(draft)
  images      String[]   @default([])

  tiers    Tier[]
  bookings Booking[]

  @@map("trips")
}

enum TripStatus {
  draft
  published
  closed

  @@map("trip_status")
}

model Tier {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  name        String
  price       Decimal  @db.Decimal(10, 2)
  description String?
  inclusions  String[]
  maxCapacity Int?     @map("max_capacity")

  trip     Trip      @relation(fields: [tripId], references: [id])
  bookings Booking[]

  @@index([tripId])
  @@map("tiers")
}

model Booking {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  tripId        String        @map("trip_id") @db.Uuid
  tierId        String        @map("tier_id") @db.Uuid
  status        BookingStatus @default(pending)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  depositAmount Decimal       @map("deposit_amount") @db.Decimal(10, 2)
  groupCode     String?       @map("group_code")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Post-booking tasks, shown in the /trip portal (see the
  // add_post_booking_forms migration). The two *_submitted flags mirror the
  // existence of a RoomingRequest / TravelerDetails row so list views and the
  // chase email can read one table.
  flightsBooked           Boolean   @default(false) @map("flights_booked")
  roomingSubmitted        Boolean   @default(false) @map("rooming_submitted")
  roomingSubmittedAt      DateTime? @map("rooming_submitted_at") @db.Timestamptz
  detailsSubmitted        Boolean   @default(false) @map("details_submitted")
  confirmationEmailSentAt DateTime? @map("confirmation_email_sent_at") @db.Timestamptz
  chaseEmailSentAt        DateTime? @map("chase_email_sent_at") @db.Timestamptz
  smsConsent              Boolean   @default(false) @map("sms_consent")
  smsConsentAt            DateTime? @map("sms_consent_at") @db.Timestamptz
  smsConsentTextVersion   String?   @map("sms_consent_text_version")

  user             User              @relation(fields: [userId], references: [id])
  trip             Trip              @relation(fields: [tripId], references: [id])
  tier             Tier              @relation(fields: [tierId], references: [id])
  payments         Payment[]
  legalAcceptances LegalAcceptance[]
  roomingRequest   RoomingRequest?
  travelerDetails  TravelerDetails?

  @@index([userId])
  @@index([tripId])
  @@index([status])
  @@index([tripId, groupCode])
  @@map("bookings")
}

enum BookingStatus {
  pending
  deposit_paid
  paid_in_full
  cancelled

  @@map("booking_status")
}

/// Evidence that a traveler accepted the Terms and the Assumption of Risk when
/// they booked. Append-only: a booking is governed by the document versions in
/// force at the moment it was made, so rows here are never updated or deleted.
/// Written server-side with the service role only (see lib/legal-acceptance.ts);
/// RLS lets a traveler read their own and nothing else.
model LegalAcceptance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String   @map("booking_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// "terms" | "assumption-of-risk", matching the slugs in lib/legal.ts
  documentSlug    String   @map("document_slug")
  /// The exact version shown, so the text accepted can be reproduced later.
  documentVersion String   @map("document_version")
  acceptedAt      DateTime @default(now()) @map("accepted_at")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([bookingId, documentSlug])
  @@index([bookingId])
  @@index([userId])
  @@map("legal_acceptances")
}

/// Who a traveler wants to room with. Rooms are assigned in submittedAt order,
/// so a BEFORE UPDATE trigger (keep_first_submitted_at) pins submittedAt to
/// the first submission; edits only move updatedAt. CHECK constraints in the
/// migration: at most three names, and names XOR noPreference.
model RoomingRequest {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String   @unique @map("booking_id") @db.Uuid
  roommateNames String[] @default([]) @map("roommate_names")
  noPreference  Boolean  @default(false) @map("no_preference")
  submittedAt   DateTime @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([submittedAt])
  @@map("rooming_requests")
}

/// Insurance, emergency and rental details. PII: service-role only (RLS on,
/// no policies, table privileges revoked from anon/authenticated). Never
/// render legalName, dateOfBirth, phone or the emergency contact back to the
/// /trip portal, whose link gets forwarded. CHECK constraints in the
/// migration: skiOrBoard in (ski, snowboard); abilityLevel in (first_time,
/// beginner, intermediate, advanced, expert). submittedAt is pinned to the
/// first submission by the same trigger as RoomingRequest.
model TravelerDetails {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String   @unique @map("booking_id") @db.Uuid
  legalName             String   @map("legal_name")
  dateOfBirth           DateTime @map("date_of_birth") @db.Date
  phone                 String
  emergencyContactName  String   @map("emergency_contact_name")
  emergencyContactPhone String   @map("emergency_contact_phone")
  height                String?
  weight                String?
  shoeSize              String?  @map("shoe_size")
  skiOrBoard            String   @map("ski_or_board")
  abilityLevel          String   @map("ability_level")
  dietaryRestrictions   String?  @map("dietary_restrictions")
  submittedAt           DateTime @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("traveler_details")
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  amount                Decimal       @db.Decimal(10, 2)
  status                PaymentStatus @default(scheduled)
  scheduledDate         DateTime?     @map("scheduled_date") @db.Date
  paidAt                DateTime?     @map("paid_at")
  // Installment retry tracking (lib/payments.ts handlePaymentIntentFailed /
  // app/api/cron/charge-installments). attemptCount only increments on a
  // real decline, never on requires_action (SCA isn't a failed attempt).
  attemptCount          Int           @default(0) @map("attempt_count")
  lastAttemptedAt       DateTime?     @map("last_attempted_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model WaitlistSignup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_signups")
}

enum PaymentStatus {
  scheduled
  pending
  succeeded
  failed
  refunded
  canceled
  // Off-session installment confirm hit SCA/3DS and needs the customer to
  // authenticate on-session before it can be retried automatically.
  requires_action

  @@map("payment_status")
}
